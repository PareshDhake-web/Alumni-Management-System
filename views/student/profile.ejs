<% layout("/layouts/boilerplate") %>

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        /* Main Container */
        .profile-container {
            width: 100%;
            max-width: 1000px;
            margin: 0 auto;
            padding: 20px;
            font-family: 'Arial', sans-serif;
            background: #f9f9f9;
            border-radius: 10px;
            box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
        }

        /* Profile Card */
        .profile-card {
            background: #fff;
            border-radius: 10px;
            overflow: hidden;
            box-shadow: 0 0 15px rgba(0, 0, 0, 0.1);
            padding: 30px;
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        /* Profile Header */
        .profile-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            border-bottom: 2px solid #f0f0f0;
            padding-bottom: 20px;
            position: relative;
        }

        /* Profile Photo - Positioned at Top Right */
        .profile-photo {
            position: absolute;
            top: -10px;
            right: 0px;
        }

        .profile-photo img {
            width: 120px;
            height: 120px;
            border-radius: 50%;
            object-fit: cover;
            border: 3px solid #8a2be2;
            /* Violet border */
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
        }

        /* Profile Info */
        .profile-info {
            flex-grow: 1;
        }

        .profile-info h1 {
            font-size: 32px;
            color: brown;
            margin-bottom: 10px;
        }

        .profile-info p {
            font-size: 16px;
            color: #4d4d4d;
            margin: 5px 0;
        }

        .profile-info p strong {
            color: brown;
        }

        /* Skills List */
        .skills-list {
            list-style-type: none;
            padding: 0;
        }

        .skills-list li {
            background: #f0f0f0;
            margin: 5px 0;
            padding: 10px;
            border-radius: 5px;
        }

        /* Job & Education Info */
        .job-info,
        .education-info {
            background: #f9f9f9;
            border-radius: 5px;
            padding: 15px;
            margin-top: 20px;
        }


        .job-info h4,
        .education-info h4 {
            font-size: 20px;
            color: brown;
        }

        /* Profile Footer */
        .profile-footer {
            display: flex;
            justify-content: center;
            gap: 15px;
            margin-top: 30px;
        }

        /* Outlined Buttons */
        .btn {
            padding: 10px 20px;
            font-size: 16px;
            border-radius: 5px;
            text-decoration: none;
            text-align: center;
            border: 2px solid;
            transition: all 0.3s ease-in-out;
        }

        .btn-outline-primary {
            color: #007bff;
            border-color: #007bff;
            background: transparent;
        }

        .btn-outline-primary:hover {
            background: #007bff;
            color: white;
        }

        .btn-outline-danger {
            color: #dc3545;
            border-color: #dc3545;
            background: transparent;
        }

        .btn-outline-danger:hover {
            background: #dc3545;
            color: white;
        }

        /* A4 Printable Version */
        @media print {
            .profile-container {
                max-width: 210mm;
                margin: 0;
                padding: 10mm;
            }

            .profile-card {
                display: block;
                padding: 20px;
                width: 100%;
            }

            .profile-header {
                display: block;
                text-align: center;
            }

            .profile-footer {
                display: none;
            }

            .profile-photo {
                display: none;
            }
        }
    </style>

    <link rel="stylesheet" href="/css/style.css" />
    <!-- Profile Page -->
    <div class="container mt-5 profile-container">
        <div class="profile-card">
            <!-- Profile Header (Photo + Basic Info) -->
            <div class="profile-header">
                <div class="profile-info">
                    <h1>
                        <%= user.username %>
                    </h1>
                    <p><strong>Email:</strong>
                        <%= user.email %>
                    </p>
                    <p><strong>Qualification:</strong>
                        <%= user.qualification %>
                    </p>
                    <p><strong>Passout Year:</strong>
                        <%= user.passoutYear %>
                    </p>
                    <p><strong>Mobile Number:</strong>
                        <%= user.mobileNo %>
                    </p>
                    <p><strong>Address:</strong>
                        <%= user.address %>
                    </p>

                    <p><strong>Gender:</strong>
                        <%= user.gender %>
                    </p>
                    <p><strong>Date of Birth:</strong>
                        <%= user.dob %>
                    </p>
                    <p><strong>City:</strong>
                        <%= user.city %>
                    </p>
                    <p><strong>Country:</strong>
                        <%= user.country %>
                    </p>
                </div>
                <div class="profile-photo">
                    <img src="<%= user.photo || 'https://tse1.mm.bing.net/th?id=OIP.BoqJ8tKGpWzJm8UbfGVbOwHaHa&pid=Api&P=0&h=180' %>" alt="Profile Photo">
                    alt="Profile Photo">
                </div>
            </div>

            <!-- Skills Section -->


            <!-- Job Experience Section -->

           <!-- Job Experience Section -->
        <% if (user.job && user.job.companyName) { %>
            <div class="job-info">
                <h4>Job Experience</h4>
                <p><strong>Company Name:</strong> <%= user.job.companyName %></p>
                <p><strong>Location:</strong> <%= user.job.location || 'Not provided' %></p>
                <p><strong>Job Title:</strong> <%= user.job.jobTitle %></p>
                <p><strong>Years of Experience:</strong> <%= user.job.yearsOfExperience || 'Not provided' %> years</p>
                <p><strong>Job Description:</strong> <%= user.job.jobDescription || 'Not provided' %></p>
            </div>
        <% } %>

        <!-- Education Section -->
        <% if (user.pg && user.pg.collegeName) { %>
            <div class="education-info">
                <h4>Post Graduation</h4>
                <p><strong>College Name:</strong> <%= user.pg.collegeName %></p>
                <p><strong>Degree Name:</strong> <%= user.pg.degreeName %></p>
                <p><strong>Special Subject:</strong> <%= user.pg.specialSubject || 'Not provided' %></p>
                <p><strong>Graduation Year:</strong> <%= user.pg.graduationYear || 'Not provided' %></p>
                <p><strong>Additional Info:</strong> <%= user.pg.additionalInfo || 'Not provided' %></p>
            </div>
        <% } %>

                            <!-- Profile Footer (Edit/Delete Buttons) -->
                            <div class="profile-footer">
                                <a href="/student_profile/<%= user._id %>/edit" class="btn btn-outline-success">Edit
                                    Profile</a>
                                <button type="button" class="btn btn-outline-danger" data-bs-toggle="modal"
                                    data-bs-target="#deleteModal">
                                    Delete Profile
                                </button>
                            </div>
        </div>
    </div>

    <!-- Delete Confirmation Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger" id="deleteModalLabel">Confirm Delete</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    Are you sure you want to delete this profile? This action cannot be undone.
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <form action="/student_profile/<%= user._id %>/delete" method="POST">
                        <button type="submit" class="btn btn-danger">Delete</button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    </div>
    </div>