<% layout("/layouts/boilerplate") %>
    <link rel="stylesheet" href="/css/style.css" />

    <style>
        /* Welcome Title with Gradient & Font Change */
        .welcome-title {
            font-size: 4rem;
            font-weight: 700;
            color: #7d5e5b;
            text-align: center;
            margin-top: 50px;
            animation: fadeIn 2s ease-in-out;
            font-family: 'Rubik', sans-serif;
        }

        /* Alumni Description */
        .alumni-description {
            font-size: 1.3rem;
            color: #555;
            text-align: center;
            margin-top: 20px;
            line-height: 1.6;
            font-family: 'Poppins', sans-serif;
        }

        /* Centered Slider Container */
        .slider-container {
            width: 600px;
            height: 400px;
            overflow: hidden;
            margin: 50px auto;
            position: relative;
            border-radius: 15px;
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.3);
        }

        .slider {
            display: flex;
            transition: transform 1s ease-in-out;
        }

        .slider-item img {
            width: 600px;
            height: 400px;
            object-fit: cover;
            border-radius: 15px;
        }

        .image-title {
            position: absolute;
            bottom: 20px;
            left: 50%;
            transform: translateX(-50%);
            color: white;
            font-size: 1.5rem;
            font-weight: bold;
            background: rgba(0, 0, 0, 0.6);
            padding: 10px;
            border-radius: 5px;
        }

        /* Teacher Cards Grid Layout */
        .teacher-cards {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 20px;
            justify-content: center;
            padding: 20px;
        }

        /* Fancy Teacher Card Styling */
        .teacher-card {
            padding: 20px;
            border-radius: 15px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.3);
            background: linear-gradient(135deg, #3a3d40, #1c1f21);
            color: white;
            text-align: left;
            transition: transform 0.3s;
        }

        .teacher-card:hover {
            transform: scale(1.05);
        }

        .teacher-card h3 {
            margin-bottom: 10px;
            color: #ffcc00;
        }

        .teacher-card p {
            color: #ddd;
            font-size: 1rem;
            margin: 5px 0;
        }

        /* Fade-In Animation */
        @keyframes fadeIn {
            0% {
                opacity: 0;
            }

            100% {
                opacity: 1;
            }
        }
    </style>

    <div class="content">
        <div class="container">
            <!-- Image Slider Card -->
            <div class="slider-container">
                <div class="slider">
                    <div class="slider-item">
                        <img src="https://tse2.mm.bing.net/th?id=OIP.L20gM-s4o2lyP6i545-LpgHaE8&pid=Api&P=0&h=180"
                            alt="Image 1">

                    </div>
                    <div class="slider-item">
                        <img src="https://tse3.mm.bing.net/th?id=OIP.kYBDlbfHZ1r43vxt1B2qKgHaE8&pid=Api&P=0&h=180"
                            alt="Image 2">

                    </div>
                    <div class="slider-item">
                        <img src="https://tse4.mm.bing.net/th?id=OIP.bGgUSnu4NA38pCaGvKTfeAHaDe&pid=Api&P=0&h=180"
                            alt="Image 3">

                    </div>
                    <div class="slider-item">
                        <img src="https://tse2.mm.bing.net/th?id=OIP.rbBF-44WdLOu-uhEGbkufQHaE8&pid=Api&P=0&h=180"
                            alt="Image 4">

                    </div>
                </div>
            </div>

            <!-- Fancy Welcome Title -->
            <h1 class="welcome-title">Welcome to the Alumni Portal</h1>
            <p class="alumni-description">Stay connected, grow your network, and explore opportunities with fellow
                alumni. Join the community now!</p>

            <!-- Teacher Data Cards -->
            <div class="teacher-cards">
                <% teachers.forEach(function(teacher) { %>
                    <div class="teacher-card">
                        <h3>
                            <%= teacher.username %>
                        </h3>
                        <p>Email: <%= teacher.email %>
                        </p>
                        <p>Address: <%= teacher.address %>
                        </p>
                        <p>Mobile: <%= teacher.mobileNo %>
                        </p>
                        <p>Expert In: <%= teacher.expertIn %>
                        </p>
                    </div>
                    <% }) %>
            </div>
        </div>
    </div>

    <script>
        let currentIndex = 0;
        const images = document.querySelectorAll('.slider-item');
        const totalImages = images.length;

        function slideImages() {
            currentIndex++;
            if (currentIndex >= totalImages) {
                currentIndex = 0;
            }
            const newTransformValue = -currentIndex * 600;
            document.querySelector('.slider').style.transform = `translateX(${newTransformValue}px)`;
        }

        setInterval(slideImages, 3000);
    </script>