<% layout("/layouts/boilerplate") %>
<link rel="stylesheet" href="/css/style.css" />

<div class="container mt-5">
  <h1 class="text-center text-primary fw-bold" style="font-family: 'Rubik', sans-serif; animation: fadeIn 2s ease-in-out;">
    About Alumni Management Portal
  </h1>
  <p class="text-center text-muted">
    Welcome to the <strong>Alumni Management Portal</strong>, a platform designed for students and teachers to manage their profiles, communicate, and stay connected after graduation.
  </p>

  <div class="row mt-4">
    <!-- Students Card -->
    <div class="col-md-6">
      <div class="card shadow-lg border-0" style="background: linear-gradient(135deg, #f0f0f0, #e3e3e3); border-radius: 15px;">
        <div class="card-body text-center">
          <i class="fas fa-user-graduate fa-3x text-primary mb-3"></i>
          <h3 class="fw-bold text-dark">For Students</h3>
          <ul class="list-unstyled text-muted">
            <li><i class="fas fa-check-circle text-success"></i> Login to view your profile and connect with teachers.</li>
            <li><i class="fas fa-check-circle text-success"></i> Update your personal and academic information.</li>
            <li><i class="fas fa-check-circle text-success"></i> Access batches, gallery, and profile details.</li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Teachers Card -->
    <div class="col-md-6">
      <div class="card shadow-lg border-0" style="background: linear-gradient(135deg, #e3e3e3, #d6d6d6); border-radius: 15px;">
        <div class="card-body text-center">
          <i class="fas fa-chalkboard-teacher fa-3x text-danger mb-3"></i>
          <h3 class="fw-bold text-dark">For Teachers</h3>
          <ul class="list-unstyled text-muted">
            <li><i class="fas fa-check-circle text-success"></i> Manage students' information easily.</li>
            <li><i class="fas fa-check-circle text-success"></i> Edit, delete, or add new student records.</li>
            <li><i class="fas fa-check-circle text-success"></i> Monitor and support student progress.</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- FontAwesome for icons -->
<script src="https://kit.fontawesome.com/a076d05399.js" crossorigin="anonymous"></script>
