<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Login and Register</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        /* Full height & prevent scrolling */
        html, body {
            height: 100%;
            margin: 0;
            padding: 0;
            overflow: hidden;
            font-family: 'Poppins', sans-serif;
        }

        /* Background Image */
        body {
            background: url("https://up.yimg.com/ib/th?id=OIP.Kp1-4q3ynkOYEFfOQj7w9wHaFG&pid=Api&rs=1&c=1&qlt=95&w=149&h=102") no-repeat center center fixed;
            background-size: cover;
        }

        /* Header & Contact Info */
        .header {
            position: absolute;
            top: 10px;
            left: 10px;
            display: flex;
            align-items: center;
        }

        .logo {
            height: 80px;
        }

        .contact-info {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 14px;
            color: rgb(230, 8, 8);
        }

        /* Center content */
        .container {
            max-width: 500px;
            margin-top: 180px;
            text-align: center;
            color: white;
        }

        .btn-custom {
            font-size: 1.2rem;
            padding: 10px 20px;
            margin: 10px;
            width: 200px;
        }

        /* Ensure footer stays at the bottom */
        footer {
            position: absolute;
            bottom: 0;
            width: 100%;
            margin-top: auto;
            text-align: center;
            background: linear-gradient(45deg, #000, #343a40);
            /* Dark gradient */
            color: white;
            padding: 25px 0;
            font-size: 1.2rem;
            box-shadow: 0 -4px 15px rgba(0, 0, 0, 0.5);
            /* Soft shadow */
            border-top: 4px solid #ff6f61;
            /* Attractive red accent */
            font-family: 'Poppins', sans-serif;
        }

        /* Modal Styling */
        .modal-dialog {
            display: flex;
            align-items: center;
            min-height: 100vh;
            justify-content: center;
        }

        .modal-content {
            background: rgba(0, 0, 0, 0.9);
            color: yellow;
            border-radius: 10px;
            padding: 20px;
        }

        .modal-header {
            border-bottom: 1px solid yellow;
        }

        .form-control {
            background: transparent;
            border: 1px solid yellow;
            color: yellow;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 0, 0.7);
        }

        .btn-primary {
            background-color: yellow;
            color: black;
            font-weight: bold;
            border: none;
        }

        .btn-primary:hover {
            background-color: orange;
        }
    </style>
</head>

<body>

    <div class="main-content">
        <!-- Header -->
        <div class="header">
            <img src="https://sbscience.org/assets/img/logo-primary.png" class="logo" alt="SBES College Logo">
        </div>
        <div class="contact-info">
            Email: sbes@college.com | Contact: 123-456-7890
        </div>

        <div class="container">
            <!-- Buttons for Login and Register -->
            <button class="btn btn-primary btn-custom" data-bs-toggle="modal" data-bs-target="#loginModal">Login</button>
            <button class="btn btn-success btn-custom" onclick="window.location.href = '/student_register';">Register</button>
        </div>

        <!-- Login Modal -->
        <div class="modal fade" id="loginModal" tabindex="-1" aria-labelledby="loginModalLabel" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="loginModalLabel">Student Login</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        <form action="/student_login" method="POST">
                            <div class="mb-3">
                                <label for="username" class="form-label">Username</label>
                                <input type="text" class="form-control" id="username" name="username" required placeholder="Enter Username">
                            </div>
                            <div class="mb-3">
                                <label for="password" class="form-label">Password</label>
                                <input type="password" class="form-control" id="password" name="password" required placeholder="Enter Password">
                            </div>
                            <button type="submit" class="btn btn-primary w-100">Login</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <%- include("../includes/footer.ejs") %>

</body>
</html>