<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Registration</title>
    
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        /* Background Styling */
        body {
            background: url("https://tse1.mm.bing.net/th?id=OIP.fzZtmQVLuJmAIwDKTFNLHAHaE9&pid=Api&P=0&h=180")  ;
            background-size: cover;
            font-family: 'Poppins', sans-serif;
            color: white;
        }

        /* Header Section */
        .header {
            position: absolute;
            top: 20px;
            left: 20px;
            display: flex;
            align-items: center;
        }

        .logo {
            height: 70px;
            margin-right: 10px;
        }

        /* Contact Info */
        .contact-info {
            position: absolute;
            top: 20px;
            right: 20px;
            font-size: 14px;
            color: red;
        }

        /* Registration Card */
        .card {
            background: rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(10px);
            border-radius: 10px;
            padding: 30px;
            box-shadow: 0px 0px 10px rgba(0, 0, 0, 0.2);
        }

        .form-control {
            background: transparent;
            border: 1px solid white;
            color: white;
        }

        .form-control::placeholder {
            color: rgba(255, 255, 255, 0.7);
        }

        /* Submit Button */
        .btn-custom {
            background-color: #27ae60;
            color: white;
            font-size: 1rem;
            padding: 10px;
            border-radius: 5px;
            width: 100%;
            transition: 0.3s;
        }

        .btn-custom:hover {
            background-color: #2ecc71;
        }

        /* Footer */
        footer {
            position: absolute;
            bottom: 0;
            width: 100%;
            background: #2c3e50;
            color: white;
            text-align: center;
            padding: 10px 0;
        }
        .back-button {
    position: absolute;
    top: 47px;
    left: 26%;
    padding: 8px 15px;
    font-size: 16px;
    color: #fff;
    background-color: #d300f8; /* Grayish background */
    border: none;
    border-radius: 5px;
    text-decoration: none;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: background 0.3s ease-in-out;
}

.back-button:hover {
    background-color: #02bcf5; /* Darker gray */
}

.back-button i {
    font-size: 18px;
}

    </style>
</head>

<body>
    <a href="/teacher_login" class="back-button">
        <i class="bi bi-arrow-left"></i> Back
    </a>
    <div class="header">
        <img src="https://sbscience.org/assets/img/logo-primary.png" class="logo" alt="SBES College Logo">
        <span class="text-white fw-bold"></span>
    </div>

    <div style="color: blueviolet;" class="contact-info">
        Email: sbes@college.com | Contact: 123-456-7890
    </div>

    <div class="d-flex justify-content-center align-items-center" style="height: 100vh;">
        <div class="card w-50">
            <h2 class="text-center">Teacher Registration</h2>

            <form action="/teacher_register" method="POST" class="mt-3">
                <div class="mb-3">
                    <input type="text" name="username" class="form-control" required placeholder="Username">
                </div>

                <div class="mb-3">
                    <input type="password" name="password" class="form-control" required placeholder="Password">
                </div>

                <div class="mb-3">
                    <input type="password" name="confirmPassword" class="form-control" required placeholder="Confirm Password">
                </div>

                <div class="mb-3">
                    <input type="email" name="email" class="form-control" required placeholder="Email">
                </div>

                <div class="mb-3">
                    <input type="text" name="address" class="form-control" required placeholder="Address">
                </div>

                <div class="mb-3">
                    <input type="text" name="mobileno" class="form-control" required placeholder="Mobile Number">
                </div>

                <div class="mb-3">
                    <input type="text" name="expertIn" class="form-control" required placeholder="Expert In">
                </div>

                <button type="submit" class="btn btn-custom">Register</button>
            </form>
        </div>
    </div>

    <%- include("../includes/footer.ejs") %>

</body>
</html>
