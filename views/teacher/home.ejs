<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alumni Portal</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
    <style>
        /* Navbar Styles */
        .navbar {
            padding: 1.5rem 0;
            background: linear-gradient(45deg, #8a2be2, #4b0082, #CC0066);
            /* Violet to Dark Violet to Pink gradient */
            box-shadow: 0 4px 8px rgba(0, 0, 0, 0.2);
            margin-bottom: 50px;
            border-radius: 10px;
        }

        .navbar .navbar-brand {
            font-size: 2rem;
            font-family: 'Roboto', 'Rubik', sans-serif;
            font-weight: 700;
            color: #fff;
        }

        .navbar .nav-link {
            font-size: 1.2rem;
            padding: 0.8rem 1rem;
            font-family: 'Poppins', sans-serif;
            color: #fff;
        }

        .navbar .nav-link:hover {
            background-color: rgba(171, 3, 115, 0.8);
            transition: 0.3s;
            border-radius: 5px;
        }

        /* Three-dot dropdown menu */
        .nav-item .nav-link i {
            font-size: 20px;
            color: white;
            cursor: pointer;
        }

        .nav-item .nav-link:hover i {
            color: #ffcc00;
        }

        /* Dropdown menu styling */
        .dropdown-menu {
            background-color: #fff;
            border-radius: 8px;
            box-shadow: 0px 4px 10px rgba(0, 0, 0, 0.2);
        }

        /* Outline buttons for dropdown */
        .dropdown-item {
            font-size: 1rem;
            font-weight: bold;
            text-align: center;
            border-radius: 10px;
            padding: 8px 12px;
            transition: all 0.3s ease-in-out;
        }

        /* Primary outline button */
        .btn-outline-primary {
            color: #007bff;
            border: 2px solid #007bff;
            background: transparent;
        }

        .btn-outline-primary:hover {
            background-color: #007bff;
            color: white;
        }

        /* Danger outline button */
        .btn-outline-danger {
            color: #dc3545;
            border: 2px solid #dc3545;
            background: transparent;
        }

        .btn-outline-danger:hover {
            background-color: #dc3545;
            color: white;
        }

        /* Fancy Search Bar */
        .input-group {
            max-width: 600px;
            margin: 20px auto;
        }

        .form-control {
            border-radius: 30px;
            padding-left: 40px;
            background-color: #e1f5fe;
            border: 2px solid #03a9f4;
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }

        .form-control::placeholder {
            color: #0288d1;
        }

        .input-group-text {
            background-color: #03a9f4;
            color: white;
            border: none;
            border-radius: 50%;
        }

        /* Cards Styling */
        .card {
            border-radius: 12px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            background: linear-gradient(to right, #ffe135, #ff6f00);
            /* Gradient background */
        }

        .card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 20px rgba(0, 0, 0, 0.15);
        }

        .card-body {
            padding: 20px;
            color: #333;
        }

        .card-title {
            color: #FF5722;
            font-size: 1.4rem;
        }

        .card-text {
            color: #424242;
            font-size: 1rem;
        }

        .btn-primary {
            background-color: #FF5722;
            border-color: #FF5722;
            border-radius: 20px;
            font-weight: bold;
        }

        .btn-primary:hover {
            background-color: #f44336;
            border-color: #f44336;
        }

        /* Student Cards Styling */
        .card {
            border-radius: 15px;
            overflow: hidden;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.1);
            background: linear-gradient(135deg, #3a3d40, #1c1f21);
            padding: 20px;
            color: white;
            text-align: left;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
            cursor: pointer;
            margin-bottom: 30px;
            width: 350px;
            height: auto;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        .card:hover {
            transform: translateY(-8px);
            box-shadow: 0 6px 18px rgba(0, 0, 0, 0.2);
            background: linear-gradient(135deg, #1c1f21, #3a3d40);
            transform: scale(1.05);
        }

        .card-title {
            margin-bottom: 10px;
            color: #ffcc00;
            font-size: 1.4rem;
        }

        .card-text {
            color: #e0e0e0;
            font-size: 1rem;
        }

        .card .btn-primary {
            padding: 10px 20px;
            font-size: 1.1rem;
            background-color: #00ffa2;
            color: #333;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }

        .card .btn-primary:hover {
            background-color: #eaff00;
            color: rgb(41, 25, 25);
        }


        /* Footer Styling */
        footer {
            background: linear-gradient(to right, #f44336, #ff9800);
            /* Gradient color */
            color: white;
            padding: 30px 0;
        }

        .f-info-socials i {
            font-size: 20px;
            margin-right: 15px;
            color: #ffeb3b;
            cursor: pointer;
            transition: color 0.3s ease;
        }

        .f-info-socials i:hover {
            color: #ff5722;
        }

        .f-info-links a {
            color: white;
            margin-right: 15px;
            text-decoration: none;
            font-weight: bold;
        }

        .f-info-links a:hover {
            text-decoration: underline;
            color: #ff9800;
        }

        .f-info-brand {
            font-weight: bold;
            font-size: 18px;
        }

        /* Button Styling for Vertical Dots Dropdown */
        .nav-item .nav-link {
            font-size: 18px;
        }
    </style>
</head>

<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand mx-auto" href="#">Students</a>
            <h1 class="d-flex " style="color: yellow;margin-left: 25%;font-size: 2.8rem;">Alumni Management Portal</h1>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse justify-content-end" id="navbarNav">
                <ul class="navbar-nav">
                    <li class="nav-item dropdown">
                        <a class="nav-link" href="#" data-bs-toggle="dropdown">
                            <i class="fas fa-ellipsis-h"></i>OPT
                        </a>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="/teacher_home/new">New Register</a></li>
                            <li><a class="dropdown-item" href="/teacher_logout">Logout</a></li>
                        </ul>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <!-- Search Bar -->
    <div class="container mt-4">
        
        <form action="/teacher_search" method="get">
            
            <div class="input-group">
                <a href="/teacher_home" class=" btn btn-outline-primary back-button">
                    <i class="bi bi-arrow-left"></i> Back
                </a>
                <input type="text" class="form-control" placeholder="Search by username" name="query"
                    aria-label="Search">
                <button class="btn btn-outline-secondary" type="submit">Search</button>
            </div>
        </form>
    </div>

    <!-- Student Cards -->
    <div class="container mt-4">
        <div class="row">
            <% if (students.length===0) { %>
                <div class="col-12 text-center">
                    <p>No students found.</p>
                </div>
                <% } else { %>
                    <% students.forEach(student=> { %>
                        <div class="col-md-4">
                            <div class="card mb-4">
                                <div class="card-body">
                                    <h5 class="card-title">
                                        <%= student.username %>
                                    </h5>
                                    <p class="card-text">Email: <%= student.email %>
                                    </p>
                                    <p class="card-text">Course: <%= student.course %> | Year: <%= student.year %>
                                    </p>
                                    <a href="/teacher_home/<%= student._id %>" class="btn btn-primary">View Details</a>
                                </div>
                            </div>
                        </div>
                        <% }); %>
                            <% } %>
        </div>
    </div>

    <%- include("../includes/footer.ejs") %>

</body>

</html>